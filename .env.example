# VEKTORFLOW-15
# Demo mode leaves the command center and API open for local use.
VEKTORFLOW_DEMO=true

# Set a key and flip demo off to lock mutating endpoints.
# VEKTORFLOW_DEMO=false
# VEKTORFLOW_API_KEY=replace-with-a-long-random-string

# NEW Supabase only: Hackathon 2026.
# Leave blank to keep receipts in memory. Generic SUPABASE_URL / SUPABASE_KEY
# are intentionally ignored so the frozen VektorFlow-15xr project is never used.
HACKATHON_SUPABASE_URL=
HACKATHON_SUPABASE_KEY=
HACKATHON_SUPABASE_TIMEOUT=5

# Meta and Muse Image stay off until credits land and Wallace second-approves
# one exact call. Do not set META_MODEL_API_KEY for this demo.
# META_MODEL_API_KEY=

PORT=8000
